# ─── Android Remote Control — Environment Config ───────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your .env file to version control!

# ── Authentication ──────────────────────────────────────────────────────────
# Generate with: python setup.sh (or run: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())")
PASSWORD_HASH=your_bcrypt_hash_here

# Random secret for signing JWT tokens (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here

# JWT token lifetime in hours (default 8)
JWT_EXPIRE_HOURS=8

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Max failed login attempts before lockout
RATE_LIMIT_MAX_ATTEMPTS=5
# Lockout duration in seconds
RATE_LIMIT_LOCKOUT_SECONDS=900

# ── ADB / Android ───────────────────────────────────────────────────────────
# Leave empty to use the first connected device
# Or specify a serial: e.g. emulator-5554 or 192.168.1.100:5555
ADB_DEVICE_SERIAL=

# Screen capture FPS (1–30 recommended)
SCREEN_FPS=10

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
